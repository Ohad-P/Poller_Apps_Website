{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poller-apps",
  "compatibility_date": "2026-09-11",
  "routes": [
    {
      "pattern": "pollerapps.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
